# Allowed values: development, preview, production
EXPO_PUBLIC_APP_ENV=development

# Firebase is opt-in. Keep false for credential-free local-only builds.
EXPO_PUBLIC_FIREBASE_ENABLED=false
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# Supply these through local environment/EAS secrets; do not commit actual values.
FIREBASE_GOOGLE_SERVICES_FILE=
FIREBASE_GOOGLE_SERVICE_INFO_FILE=
IOS_BUNDLE_IDENTIFIER=
EXPO_PUBLIC_FIREBASE_GOOGLE_WEB_CLIENT_ID=

# Required release metadata. Production values must be public HTTPS pages.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# Production AdMob identifiers. Non-production builds always use Google's test inventory.
ADMOB_ANDROID_APP_ID= ca-app-pub-9093667472808260~2481058177
ADMOB_IOS_APP_ID= ca-app-pub-0000000000000000~0000000000 # geçiçi sahte.
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID= ca-app-pub-9093667472808260/9577215494
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID= ca-app-pub-9093667472808260/8659453714
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID= ca-app-pub-9093667472808260/9508932730
