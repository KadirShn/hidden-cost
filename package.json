    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "format": "prettier --write \"**/*.{js,json,ts,tsx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,ts,tsx,css,yml,yaml}\"",
