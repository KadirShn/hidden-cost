{
  "expo": {
    "name": "Hidden Cost",
    "slug": "hidden-cost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "hiddencost",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071630",
        "foregroundImage": "./assets/brand/brand-mark.png",
        "monochromeImage": "./assets/brand/brand-mark-monochrome.png"
      },
      "icon": "./assets/brand/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.kadirshn.hiddencost"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071630",
          "image": "./assets/brand/brand-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#030A18",
            "image": "./assets/brand/brand-mark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appEnvironment": "development",
      "ads": {
        "testMode": true,
        "productionUnitIdsConfigured": false
      },
      "firebase": {
        "configured": false,
        "emulatorHost": "10.0.2.2",
        "googleWebClientId": {},
        "useEmulators": false
      },
      "legal": {
        "privacyPolicyUrl": {},
        "accountDeletionUrl": {}
      },
      "router": {},
      "eas": {
        "projectId": "40be20eb-8475-45c5-a6e8-dabc5b8e6ee0"
      }
    },
    "owner": "kadirshn"
  }
}
